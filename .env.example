# Copiar a .env y cambiar TODOS los valores de ejemplo. Nunca subir .env al repositorio.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
WEB_PORT=8000

# Institución (SPEC §16: nada institucional fijo en el código)
INSTITUCION_NOMBRE=Gobierno Autonomo Departamental de La Paz
INSTITUCION_SIGLA=GADLP

POSTGRES_DB=gestion_documental
POSTGRES_USER=gestion
POSTGRES_PASSWORD=cambiar-esta-clave
DATABASE_URL=postgres://gestion:cambiar-esta-clave@db:5432/gestion_documental

S3_ENDPOINT_URL=http://s3:8333
S3_ACCESS_KEY=cambiar-access-key
S3_SECRET_KEY=cambiar-secret-key
S3_BUCKET=documentos
S3_REGION=us-east-1

EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=correspondencia@localhost

# Reglas de negocio
# 0 = sin reservas (decisión del Director, levantamiento A5). Máximo 24 si se habilita.
CITE_RESERVA_HORAS=0
ADJUNTO_MAX_MB=25
IMPORTACION_MAX_MB=10
# Institutos: textos del derecho propietario que indican titularidad de la entidad
# Teléfonos de autoridades: no se importan salvo decisión expresa (minimización)
INSTITUTOS_CARGAR_TELEFONOS=False
INSTITUTOS_TITULAR_PATRONES=gobierno autonomo departamental,gadlp
# Mapa base (vacío = solo puntos). Para OpenStreetMap ver docs/modulo-institutos.md
MAPA_TESELAS_URL=
MAPA_TESELAS_ATRIBUCION=
CSP_IMG_SRC_EXTRA=
# Ubicación aproximada por municipio (comando aproximar_ubicaciones)
NOMINATIM_CONTACTO=
INSTITUTOS_REGION_BUSQUEDA=La Paz
INSTITUTOS_PAIS=bo
INTEROP_HABILITADO=False

# Seguridad (docs/seguridad.md)
SESION_INACTIVIDAD_MIN=30
SESION_MAXIMA_HORAS=10
MFA_OBLIGATORIO_ROLES=administrador,director,auditor
MFA_OBLIGATORIO_TODOS=False
AXES_FAILURE_LIMIT=5
AXES_BLOQUEO_MINUTOS=15
# Proxies inversos confiables delante de la app (EasyPanel/Traefik = 1; sin proxy = 0).
PROXIES_CONFIABLES=0
# Correos que reciben alertas de seguridad y de respaldo (separados por coma)
ALERTAS_EMAIL=
ANTIVIRUS_HABILITADO=False

# Respaldo multi-destino (docs/respaldos.md)
# Hora del respaldo diario (formato cron) y zona horaria del contenedor de respaldo
BACKUP_HORARIO=0 2 * * *
TZ=America/La_Paz
BACKUP_DESTINOS=local
BACKUP_RETENCION=7d,4w,12m
RESTIC_REPOSITORY_local=/respaldos/restic
RESTIC_PASSWORD_local=cambiar-clave-de-respaldo-local
# Ejemplo de segundo destino en nube (descomentar y agregar "nube1" a BACKUP_DESTINOS):
# RESTIC_REPOSITORY_nube1=s3:https://s3.amazonaws.com/mi-bucket-respaldo
# RESTIC_PASSWORD_nube1=otra-clave-distinta
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
RCLONE_CONFIG_DIR=./secrets/rclone
# Alerta si no hay respaldo exitoso en este número de horas (en producción se vigila por defecto)
RESPALDO_ALERTA_HORAS=26
