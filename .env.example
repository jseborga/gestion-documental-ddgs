# Copiar a .env y cambiar TODOS los valores de ejemplo. Nunca subir .env al repositorio.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
WEB_PORT=8000

POSTGRES_DB=gestion_documental
POSTGRES_USER=gestion
POSTGRES_PASSWORD=cambiar-esta-clave
DATABASE_URL=postgres://gestion:cambiar-esta-clave@db:5432/gestion_documental

S3_ENDPOINT_URL=http://s3:8333
S3_ACCESS_KEY=cambiar-access-key
S3_SECRET_KEY=cambiar-secret-key
S3_BUCKET=documentos
S3_REGION=us-east-1

EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=correspondencia@localhost

# Reglas de negocio
CITE_RESERVA_HORAS=24
ADJUNTO_MAX_MB=25
INTEROP_HABILITADO=False

# Respaldo (scripts/backup.sh)
RESTIC_REPOSITORY=/respaldos/restic
RESTIC_PASSWORD=cambiar-clave-de-respaldo
